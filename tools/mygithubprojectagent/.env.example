# GitHub Configuration
# Generate token at: https://github.com/settings/tokens
# Required scopes: repo (for private repositories)
GITHUB_TOKEN=ghp_your_github_personal_access_token_here

# LLM Configuration
# OpenAI (default)
OPENAI_API_KEY=sk-your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Alternative: Anthropic Claude (or compatible APIs like Kimi)
# ANTHROPIC_API_KEY=sk-ant-your_anthropic_key_here
# ANTHROPIC_MODEL=claude-3-haiku-20240307
# ANTHROPIC_BASE_URL=https://api.anthropic.com  # Optional: for custom endpoints (e.g., Kimi)

# Embedding Configuration
# Options: openai, sentence-transformers
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Vector Database Configuration
# ChromaDB settings
CHROMA_DB_PATH=./chroma_db
CHROMA_COLLECTION_NAME=github_repo_collection

# Application Settings
LOG_LEVEL=INFO
CACHE_DIR=./cache
MAX_FILE_SIZE_MB=5
EXCLUDE_PATTERNS=node_modules/,__pycache__/,*.pyc,.git/,dist/,build/,*.min.js,*.min.css

# Privacy Settings
# Enable/disable specific sanitizers
SANITIZE_API_KEYS=true
SANITIZE_PASSWORDS=true
SANITIZE_TOKENS=true
SANITIZE_EMAILS=true
SANITIZE_SECRETS=true

# Redaction style: hash, mask, or remove
REDACTION_STYLE=mask
